# VC Audit Tool — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── LLM Providers ─────────────────────────────────────────────────────────
# Priority order: Gemini > OpenAI > Claude > Ollama > Regex fallback
# Gemini Flash is the recommended default (~$0.001/request).
GOOGLE_API_KEY=your-gemini-api-key

# Optional: OpenAI or Anthropic as fallbacks
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# Optional: local Ollama model name
# OLLAMA_MODEL=llama3.2

# ── Pinecone (vector comps ranking) ────────────────────────────────────────
# Set to enable Pinecone-hosted inference for comparable company ranking.
# The index will be auto-created on first use if it does not exist.
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=vc-audit-edgar-comps

# Optional: override the embedding model (default: multilingual-e5-large)
# PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# ── Supabase (PostgreSQL store) ─────────────────────────────────────────────
# Set both to enable PostgreSQL storage instead of SQLite WAL.
# Use the anon key (RLS is disabled) or a service-role key.
SUPABASE_URL=https://drykfbevdfyivyhnkyfc.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── SEC EDGAR ──────────────────────────────────────────────────────────────
# Required when fetching live EDGAR filings.
VC_AUDIT_SEC_USER_AGENT=Your Name your-email@company.com

# ── Mock mode ─────────────────────────────────────────────────────────────
# Set to 1 to force mock data sources (useful for local dev without API keys).
# VC_AUDIT_MOCK=1
